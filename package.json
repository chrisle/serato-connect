{
  "name": "serato-connect",
  "version": "1.1.1",
  "description": "Library to read Serato DJ history files and emit change events",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --build tsconfig.json",
    "watch": "tsc --build tsconfig.json -w",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "release": "node .github/release.js",
    "release:patch": "node .github/release.js --patch",
    "release:major": "node .github/release.js --major"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "bonjour-service": "^1.3.0",
    "music-metadata": "^10.7.0",
    "strict-event-emitter-types": "^2.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.29",
    "@vitest/coverage-v8": "^4.0.16",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "rollup": ">=4.59.0"
  }
}
